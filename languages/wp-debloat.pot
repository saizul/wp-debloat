#: src/Tweaks/Admin/AdminBarFrontEnd.php:30
msgid "Hide the admin bar on the front end"
msgstr ""

#: src/Tweaks/Admin/AdminBarFrontEnd.php:34
msgid "Hides the toolbar on the front end for users who cannot manage options (subscribers, customers, authors), or for everyone. The admin is not changed."
msgstr ""

#: src/Tweaks/Admin/AdminBarFrontEnd.php:42
msgid "Hide for"
msgstr ""

#: src/Tweaks/Admin/AdminBarFrontEnd.php:46
msgid "Everyone"
msgstr ""

#: src/Tweaks/Admin/AdminBarFrontEnd.php:46
msgid "Everyone except administrators"
msgstr ""

#: src/Tweaks/Admin/AdminEmailCheck.php:29
msgid "Disable the admin e-mail confirmation screen"
msgstr ""

#: src/Tweaks/Admin/AdminEmailCheck.php:33
msgid "Stops WordPress from asking administrators every six months, right after login, to confirm that the site admin e-mail address is still correct."
msgstr ""

#: src/Tweaks/Admin/BlockDirectory.php:29
msgid "Disable the block directory in the editor"
msgstr ""

#: src/Tweaks/Admin/BlockDirectory.php:33
msgid "Stops the block editor from suggesting and installing blocks from WordPress.org when a search in the inserter finds nothing. Blocks can still be installed as plugins."
msgstr ""

#: src/Tweaks/Admin/DashboardNews.php:29
msgid "Remove the WordPress Events and News widget"
msgstr ""

#: src/Tweaks/Admin/DashboardNews.php:33
msgid "Removes the WordPress Events and News box from the dashboard and the network dashboard, so the dashboard no longer fetches remote news feeds and nearby events."
msgstr ""

#: src/Tweaks/Admin/DashboardWidgets.php:37
msgid "Clean up the dashboard"
msgstr ""

#: src/Tweaks/Admin/DashboardWidgets.php:41
msgid "Removes the Welcome panel, the Quick Draft box and the Activity box from the dashboard. At a Glance and Site Health stay. Boxes added by other plugins are not touched."
msgstr ""

#: src/Tweaks/Admin/UpdateNags.php:29
msgid "Hide update notices from non-administrators"
msgstr ""

#: src/Tweaks/Admin/UpdateNags.php:33
msgid "Editors, authors and other users who cannot update WordPress no longer see the \"WordPress x.y is available\" and maintenance notices. Administrators still see them and updates are not affected."
msgstr ""

#: src/Tweaks/Content/AttachmentPages.php:29
msgid "Redirect attachment pages"
msgstr ""

#: src/Tweaks/Content/AttachmentPages.php:33
msgid "Redirects the thin attachment pages WordPress creates for every upload to the post the file is attached to, or to the file itself when it is not attached or the parent is not public. Also switches the \"attachment pages\" option of WordPress 6.4+ off."
msgstr ""

#: src/Tweaks/Content/AuthorArchives.php:31
msgid "Disable author archives"
msgstr ""

#: src/Tweaks/Content/AuthorArchives.php:35
msgid "Author archive pages (/author/name/) return a 404 or redirect to the home page, and author links point to the home page. Useful for single-author sites, where the author archive duplicates the blog. Not part of any preset."
msgstr ""

#: src/Tweaks/Content/AuthorArchives.php:51
msgid "Author archives"
msgstr ""

#: src/Tweaks/Content/AuthorArchives.php:55
msgid "Redirect to the home page"
msgstr ""

#: src/Tweaks/Content/AuthorArchives.php:55
msgid "Show a 404 page"
msgstr ""

#: src/Tweaks/Content/Comments.php:36
msgid "Disable comments everywhere"
msgstr ""

#: src/Tweaks/Content/Comments.php:40
msgid "Closes comments and pings on all content, hides existing comments, removes the Comments admin menu, admin bar item, dashboard and discussion screens, the comments feed and its links, the comments REST API routes, the Recent Comments widget and the comment-reply script. Existing comments are not deleted and come back when the tweak is switched off."
msgstr ""

#: src/Tweaks/Content/CoreSitemaps.php:30
msgid "Disable the core XML sitemaps"
msgstr ""

#: src/Tweaks/Content/CoreSitemaps.php:34
msgid "Turns off wp-sitemap.xml. Only switch this on when an SEO plugin provides its own sitemap or you do not want search engines to get one. Not part of any preset."
msgstr ""

#: src/Tweaks/Content/Feeds.php:35
msgid "Disable RSS and Atom feeds"
msgstr ""

#: src/Tweaks/Content/Feeds.php:39
msgid "Redirects every feed URL to the home page and removes all feed links from the page head. Feed readers, podcast apps, newsletter tools and services that import your posts through RSS stop working. Not part of any preset."
msgstr ""

#: src/Tweaks/Content/Search.php:30
msgid "Disable the front-end search"
msgstr ""

#: src/Tweaks/Content/Search.php:34
msgid "Search requests (?s=) on the front end return a 404, the search form and the Search widget are removed and the admin bar search box is hidden. Spam searches no longer cost database queries. Search in the admin and in the REST API is not changed, and the Search block in block themes still renders. Not part of any preset."
msgstr ""

#: src/Tweaks/Performance/AssetQueryStrings.php:30
msgid "Remove version query strings from scripts and styles"
msgstr ""

#: src/Tweaks/Performance/AssetQueryStrings.php:34
msgid "Removes the ver= parameter from front-end CSS and JavaScript URLs. Only useful for proxies that refuse to cache URLs with query strings. Visitors and caches may keep old files after an update until their cache expires, so this is not part of any preset."
msgstr ""

#: src/Tweaks/Performance/AutosaveInterval.php:30
msgid "Change the autosave interval"
msgstr ""

#: src/Tweaks/Performance/AutosaveInterval.php:34
msgid "Autosaves posts every this many seconds instead of every 60 seconds, which means fewer requests and autosave revisions. If AUTOSAVE_INTERVAL is already defined in wp-config.php, the block editor still uses this value but the classic editor uses the constant."
msgstr ""

#: src/Tweaks/Performance/AutosaveInterval.php:42 src/Tweaks/Performance/HeartbeatInterval.php:42
msgid "Interval in seconds"
msgstr ""

#: src/Tweaks/Performance/BlockLibraryCss.php:36
msgid "Remove block library CSS on pages without blocks"
msgstr ""

#: src/Tweaks/Performance/BlockLibraryCss.php:40
msgid "On single posts and pages written without blocks (classic editor, page builders), dequeues the block library stylesheets. Only for classic themes; skipped on block themes, on archives and when block widgets are in use. Blocks added by the theme templates or shortcodes can lose their styling."
msgstr ""

#: src/Tweaks/Performance/Dashicons.php:29
msgid "Remove Dashicons for logged-out visitors"
msgstr ""

#: src/Tweaks/Performance/Dashicons.php:33
msgid "Dequeues the Dashicons icon font on the front end for visitors who are not logged in (the admin bar needs it only for logged-in users). If a theme or plugin declares Dashicons as a dependency, it is still loaded."
msgstr ""

#: src/Tweaks/Performance/Embeds.php:29
msgid "Disable WordPress post embeds (oEmbed provider)"
msgstr ""

#: src/Tweaks/Performance/Embeds.php:33
msgid "Removes the oEmbed discovery links, the oEmbed REST route and the wp-embed script, and stops discovering oEmbed data on unknown sites. Other sites can no longer embed your posts as cards. Embeds from known providers such as YouTube keep working."
msgstr ""

#: src/Tweaks/Performance/Emojis.php:30
msgid "Remove emoji scripts and styles"
msgstr ""

#: src/Tweaks/Performance/Emojis.php:34
msgid "Removes the inline emoji detection script and emoji styles from every page, the admin and embeds, and stops converting emoji to images in feeds and e-mails. Modern browsers display emoji on their own."
msgstr ""

#: src/Tweaks/Performance/FeedLinksExtra.php:29
msgid "Remove comment and archive feed links"
msgstr ""

#: src/Tweaks/Performance/FeedLinksExtra.php:33
msgid "Removes the head links to the comments feed and to category, tag, author and search feeds. The main posts feed link stays and all feeds keep working."
msgstr ""

#: src/Tweaks/Performance/GlobalStyles.php:31
msgid "Remove global styles and duotone filters (classic themes)"
msgstr ""

#: src/Tweaks/Performance/GlobalStyles.php:35
msgid "Removes the inline global-styles CSS (colour and font-size preset classes from theme.json) and the duotone SVG filters on the front end. Only applies to classic themes. Blocks that use preset colours, font sizes or duotone can lose that styling."
msgstr ""

#: src/Tweaks/Performance/HeartbeatFrontEnd.php:30
msgid "Disable the Heartbeat API on the front end"
msgstr ""

#: src/Tweaks/Performance/HeartbeatFrontEnd.php:34
msgid "Stops the Heartbeat script (regular admin-ajax.php requests) on front-end pages. The admin and the editor keep Heartbeat for autosave and post locking. Front-end features of some plugins (live chat, front-end editors) can rely on it."
msgstr ""

#: src/Tweaks/Performance/HeartbeatInterval.php:30
msgid "Slow down the Heartbeat API"
msgstr ""

#: src/Tweaks/Performance/HeartbeatInterval.php:34
msgid "Sets how often the browser sends Heartbeat requests (WordPress uses 15 to 60 seconds). Fewer requests mean less server load on busy admin screens. Kept at 120 seconds or less so post locks keep working."
msgstr ""

#: src/Tweaks/Performance/JqueryMigrate.php:30
msgid "Remove jQuery Migrate on the front end"
msgstr ""

#: src/Tweaks/Performance/JqueryMigrate.php:34
msgid "Loads jQuery without the jQuery Migrate compatibility layer for visitors. Old themes or plugins that use removed jQuery functions can break; check the browser console after switching it on. The admin is not changed."
msgstr ""

#: src/Tweaks/Performance/RemoteBlockPatterns.php:29
msgid "Do not load remote block patterns"
msgstr ""

#: src/Tweaks/Performance/RemoteBlockPatterns.php:33
msgid "Stops the block editor from downloading core and featured patterns from the WordPress.org pattern directory. Patterns registered by your theme and plugins are still available."
msgstr ""

#: src/Tweaks/Performance/RestApiLink.php:29
msgid "Remove the REST API discovery link"
msgstr ""

#: src/Tweaks/Performance/RestApiLink.php:33
msgid "Removes the api.w.org link from the page head and the Link HTTP header. The REST API itself keeps working; only the advertisement is removed."
msgstr ""

#: src/Tweaks/Performance/RevisionsLimit.php:30
msgid "Limit post revisions"
msgstr ""

#: src/Tweaks/Performance/RevisionsLimit.php:34
msgid "Keeps at most this many revisions per post instead of an unlimited number, which keeps the posts table small. Older revisions are removed the next time a post is saved. A lower WP_POST_REVISIONS value in wp-config.php is respected; 0 turns revisions off."
msgstr ""

#: src/Tweaks/Performance/RevisionsLimit.php:42
msgid "Revisions to keep"
msgstr ""

#: src/Tweaks/Performance/RsdLink.php:29
msgid "Remove the RSD link"
msgstr ""

#: src/Tweaks/Performance/RsdLink.php:33
msgid "Removes the Really Simple Discovery link from the page head. It only helps old blog editors find the XML-RPC endpoint."
msgstr ""

#: src/Tweaks/Performance/SelfPingbacks.php:29
msgid "Disable self pingbacks"
msgstr ""

#: src/Tweaks/Performance/SelfPingbacks.php:33
msgid "Stops WordPress from sending pingbacks to your own site when a post links to another post, which creates pointless pingback comments and requests."
msgstr ""

#: src/Tweaks/Performance/Shortlink.php:29
msgid "Remove the shortlink"
msgstr ""

#: src/Tweaks/Performance/Shortlink.php:33
msgid "Removes the ?p= shortlink from the page head and the Link HTTP header. Search engines use the canonical URL instead."
msgstr ""

#: src/Tweaks/Performance/WlwManifest.php:29
msgid "Remove the Windows Live Writer manifest link"
msgstr ""

#: src/Tweaks/Performance/WlwManifest.php:33
msgid "Removes the wlwmanifest link for the discontinued Windows Live Writer editor. WordPress 6.3 and later no longer print it; the tweak is kept for older versions."
msgstr ""

#: src/Tweaks/Security/ApplicationPasswords.php:30
msgid "Disable application passwords"
msgstr ""

#: src/Tweaks/Security/ApplicationPasswords.php:34
msgid "Turns off application passwords, which let external apps log in to the REST API and XML-RPC with a separate password. Existing application passwords stop working. Breaks integrations that use them (some mobile apps, automation services, remote publishing tools)."
msgstr ""

#: src/Tweaks/Security/AuthorQuery.php:29
msgid "Block ?author=N user enumeration"
msgstr ""

#: src/Tweaks/Security/AuthorQuery.php:33
msgid "Redirects requests such as /?author=1 to the home page before WordPress turns them into /author/user-name/, so bots cannot read user names by counting IDs. Author archive links themselves keep working."
msgstr ""

#: src/Tweaks/Security/FileEditor.php:34
msgid "Disable the theme and plugin file editor"
msgstr ""

#: src/Tweaks/Security/FileEditor.php:38
msgid "Removes the Theme File Editor and Plugin File Editor screens for everyone, so a stolen administrator login cannot be used to write PHP code from the dashboard. Installing and updating plugins is not affected."
msgstr ""

#: src/Tweaks/Security/FileEditor.php:46
msgid "For stronger protection that also works when this plugin is off, add define( 'DISALLOW_FILE_EDIT', true ); to wp-config.php."
msgstr ""

#: src/Tweaks/Security/HideVersion.php:29
msgid "Hide the WordPress version"
msgstr ""

#: src/Tweaks/Security/HideVersion.php:33
msgid "Removes the generator meta tag from the page head and feeds, and replaces ver= values equal to the WordPress version in script and style URLs with a hash, so the version is not shown but caches are still refreshed after an update."
msgstr ""

#: src/Tweaks/Security/LoginErrors.php:29
msgid "Generic login error message"
msgstr ""

#: src/Tweaks/Security/LoginErrors.php:33
msgid "Shows one generic message on the login screen instead of telling visitors whether the user name or the password was wrong, so bots cannot confirm that an account exists."
msgstr ""

#: src/Tweaks/Security/LoginErrors.php:51
msgid "Error:"
msgstr ""

#: src/Tweaks/Security/LoginErrors.php:51
msgid "The login details are incorrect. Please try again."
msgstr ""

#: src/Tweaks/Security/RestAllowlist.php:32
msgid "Restrict the REST API for logged-out visitors"
msgstr ""

#: src/Tweaks/Security/RestAllowlist.php:36
msgid "Logged-out visitors get a 401 error from every REST API route except the ones listed below (one namespace or route per line, e.g. /contact-form-7/v1). Contact forms, shops, search and other front-end features that call the REST API break unless their route is listed. Test every form and front-end feature after switching it on."
msgstr ""

#: src/Tweaks/Security/RestAllowlist.php:48
msgid "Allowed routes (one per line)"
msgstr ""

#: src/Tweaks/Security/RestAllowlist.php:73
msgid "The REST API is only available to logged-in users on this site."
msgstr ""

#: src/Tweaks/Security/RestUsers.php:29
msgid "Block user enumeration through the REST API"
msgstr ""

#: src/Tweaks/Security/RestUsers.php:33
msgid "Logged-out visitors get a 401 error from /wp-json/wp/v2/users, which otherwise lists the user names (slugs) of everyone who published a post. Logged-in users and the block editor are not affected."
msgstr ""

#: src/Tweaks/Security/RestUsers.php:58
msgid "Sorry, you are not allowed to list users."
msgstr ""

#: src/Tweaks/Security/SecurityHeaders.php:39
msgid "Send basic security headers"
msgstr ""

#: src/Tweaks/Security/SecurityHeaders.php:43
msgid "Adds X-Content-Type-Options: nosniff, X-Frame-Options: SAMEORIGIN and Referrer-Policy: strict-origin-when-cross-origin to front-end pages, unless another plugin already set them. Other sites can no longer show your pages in a frame."
msgstr ""

#: src/Tweaks/Security/SitemapUsers.php:29
msgid "Remove users from the core XML sitemap"
msgstr ""

#: src/Tweaks/Security/SitemapUsers.php:33
msgid "Removes the wp-sitemap-users-1.xml sitemap, which lists the author archive URL (and so the user name) of everyone who published a post. Posts, pages and terms stay in the sitemap. Has no effect when an SEO plugin replaces the core sitemap."
msgstr ""

#: src/Tweaks/Security/XmlrpcOff.php:30
msgid "Disable XML-RPC completely"
msgstr ""

#: src/Tweaks/Security/XmlrpcOff.php:34
msgid "Turns off every xmlrpc.php method (the xmlrpc_enabled filter alone only blocks methods that need a login) and removes the X-Pingback header. Blocks brute-force and pingback abuse through XML-RPC. Breaks tools that still use XML-RPC, such as Jetpack connections, very old mobile apps and some desktop editors."
msgstr ""

#: src/Tweaks/Security/XmlrpcPingbacks.php:34
msgid "Disable XML-RPC pingback methods"
msgstr ""

#: src/Tweaks/Security/XmlrpcPingbacks.php:38
msgid "Removes the pingback.ping and pingback.extensions.getPingbacks XML-RPC methods and the X-Pingback header, so your site cannot be used for pingback DDoS amplification. Other XML-RPC methods (Jetpack, apps) keep working. Incoming pingbacks stop."
msgstr ""

#: wp-debloat.php:26
msgid "Debloat & Harden requires PHP 7.4 or newer."
msgstr ""
